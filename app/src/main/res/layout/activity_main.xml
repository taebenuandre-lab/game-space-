<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="@color/neon_cyan"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="22"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/app_tagline"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Status layanan -->
        <LinearLayout style="@style/CardPanel">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/section_status" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/status_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_status_dot" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:textColor="@color/neon_alert"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_status_hint"
                style="@style/BodyText"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/btn_service"
                style="@style/NeonButton"
                android:layout_marginTop="16dp" />
        </LinearLayout>

        <!-- Pengaturan tap -->
        <LinearLayout style="@style/CardPanel">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/section_config" />

            <TextView
                android:id="@+id/tv_interval_label"
                style="@style/BodyText"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_primary" />

            <SeekBar
                android:id="@+id/seek_interval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progressBackgroundTint="@color/card_stroke"
                android:progressTint="@color/neon_cyan"
                android:thumbTint="@color/neon_purple" />

            <TextView
                android:id="@+id/tv_hold_label"
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary" />

            <SeekBar
                android:id="@+id/seek_hold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progressBackgroundTint="@color/card_stroke"
                android:progressTint="@color/neon_cyan"
                android:thumbTint="@color/neon_purple" />

            <TextView
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:text="@string/label_repeat"
                android:textColor="@color/text_primary" />

            <EditText
                android:id="@+id/et_repeat"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_repeat"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="7"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_jitter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_jitter"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Aksi -->
        <LinearLayout style="@style/CardPanel">

            <TextView
                android:id="@+id/btn_overlay"
                style="@style/NeonButton" />

            <TextView
                android:id="@+id/btn_stop"
                style="@style/NeonButton.Alert"
                android:layout_marginTop="12dp"
                android:text="@string/btn_stop" />

            <TextView
                android:id="@+id/btn_library"
                style="@style/NeonButton.Outline"
                android:layout_marginTop="12dp"
                android:text="@string/btn_library" />
        </LinearLayout>

        <!-- Panduan -->
        <LinearLayout style="@style/CardPanel">

            <TextView
                style="@style/SectionLabel"
                android:text="@string/section_guide" />

            <TextView
                style="@style/BodyText"
                android:layout_marginTop="10dp"
                android:text="@string/guide_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
