<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Zack Game Space</string>
    <string name="app_tagline">Auto tap neon untuk game favoritmu</string>
    <string name="service_label">Zack Auto Tap</string>
    <string name="accessibility_description">Zack Game Space memakai layanan aksesibilitas hanya untuk mengirim tap otomatis ke titik yang kamu pilih. Layanan ini tidak membaca isi layar dan tidak mengirim data ke mana pun.</string>

    <!-- Status -->
    <string name="section_status">STATUS LAYANAN</string>
    <string name="status_off">NONAKTIF</string>
    <string name="status_hint_off">Aktifkan Zack Auto Tap di pengaturan Aksesibilitas agar bisa mengirim tap.</string>
    <string name="status_waiting">MENUNGGU</string>
    <string name="status_hint_waiting">Layanan sudah diaktifkan, sedang menyambung. Buka ulang aplikasi bila status tidak berubah.</string>
    <string name="status_ready">SIAP</string>
    <string name="status_hint_ready">Layanan aktif. Tampilkan overlay, buka game, lalu tekan MULAI.</string>
    <string name="status_running">AUTO TAP BERJALAN</string>
    <string name="status_hint_running">Tap terkirim: %1$d. Tekan STOP di overlay atau di sini untuk berhenti.</string>
    <string name="btn_service_enable">AKTIFKAN LAYANAN AKSESIBILITAS</string>
    <string name="btn_service_manage">BUKA PENGATURAN AKSESIBILITAS</string>

